# Copy to .env (gitignored). Never commit real values.

# SingleStore connection, e.g. user:password@host:3306/last_wishes
# Leave empty to use the local SQLite development database.
SINGLESTORE_URL=
# Superlinked SIE Serverless (required for live extraction)
SIE_API_KEY=
SIE_BASE_URL=
# Cognee needs an LLM key for add/cognify (see Cognee docs); ANTHROPIC_API_KEY is used as a fallback
LLM_API_KEY=
# Drafting/explanations only
ANTHROPIC_API_KEY=
# Persona sandbox
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=

# Optional overrides (defaults are used when unset)
# LLM_MODEL=            # Cognee LLM model name
# LW_COGNIFY=auto       # set to 0 to skip cognee.add/cognify even when an LLM key exists
# LW_DB=                # set to sqlite to force the local database
# LW_SQLITE_PATH=       # path of the local SQLite file
# LW_VECTOR_DIM=        # vector column size (not created on the free shared tier)
# SIE_WAIT_S=600        # seconds to wait for a cold SIE model
# PERSONA_VERSION=2026-09-29
